<mxCell id="n_corenote" value="&lt;b&gt;Every node&lt;/b&gt; → registry: REGISTER once, HEARTBEAT 1/s, LOOKUP by name&lt;br&gt;&lt;b&gt;Gateways&lt;/b&gt; → registry: RESOLVE sid → hosting site (then cached)&lt;br&gt;&lt;b&gt;Orchestrator&lt;/b&gt; → any site: ALLOCATE / RESIZE / RELEASE&lt;br&gt;&lt;b&gt;Sites&lt;/b&gt; → orchestrator: INSTANCE_EXIT&lt;br&gt;&lt;br&gt;&lt;b&gt;Hosts&lt;/b&gt; UPF (≤ 10 ms) under &lt;i&gt;tier_aware&lt;/i&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="n_core">
<mxGeometry x="630" y="22" width="420" height="150" as="geometry"/>
</mxCell>
