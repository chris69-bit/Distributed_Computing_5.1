<mxCell id="n_legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#00AA00&quot;&gt;■&lt;/font&gt; from S1/S2&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#D6006E&quot;&gt;■&lt;/font&gt; new in S3&lt;br&gt;&lt;font color=&quot;#D6006E&quot;&gt;&lt;b&gt;pink&lt;/b&gt;&lt;/font&gt; = data plane (traffic)&lt;br&gt;&lt;font color=&quot;#3333FF&quot;&gt;blue dashed&lt;/font&gt; = control plane&lt;br&gt;&lt;font color=&quot;#036897&quot;&gt;&lt;b&gt;thick&lt;/b&gt;&lt;/font&gt; = network link (bandwidth · one-way delay)&lt;br&gt;Every box with “container” = one Docker container" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
<mxGeometry x="20" y="60" width="420" height="100" as="geometry"/>
</mxCell>
<mxCell id="n_sp1" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Service decomposition&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. Registry – naming, liveness, routes (core)&lt;br&gt;2. Orchestrator – admission + placement (core)&lt;br&gt;3. Telemetry – metrics from every node (cloud)&lt;br&gt;4. API gateways gw-A, gw-B – the only user entry (edge)&lt;br&gt;5. Sites edge-A, edge-B, core-1, cloud-1 – compute" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
<mxGeometry x="20" y="185" width="420" height="150" as="geometry"/>
</mxCell>
<mxCell id="n_sp2" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Placement: tier_aware (new)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. Keep every latency check from S1 (≤ bound)&lt;br&gt;2. Among feasible sites pick the FARTHEST tier&lt;br&gt;3. cloud &amp;gt; core &amp;gt; edge, then least loaded&lt;br&gt;4. Edge capacity stays free for vRAN-DUs" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
<mxGeometry x="20" y="345" width="420" height="120" as="geometry"/>
</mxCell>
<mxCell id="n_sp3" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Deployment (Docker Compose)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. One image, 10 containers, one network&lt;br&gt;2. CPU quota per site ∝ tier size (0.25 / 0.5 / 0.75)&lt;br&gt;3. Only the registry address is configured&lt;br&gt;4. Same config.json drives local and Docker runs" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
<mxGeometry x="20" y="480" width="420" height="120" as="geometry"/>
</mxCell>
<mxCell id="n_sp4" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Experiments (Milestone 3)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. S2 monolith vs S3 microservices: overhead&lt;br&gt;2. edge_first vs least_loaded vs tier_aware&lt;br&gt;3. Scale-out: 1 → 4 compute sites&lt;br&gt;4. Control plane: 4 → 1 024 sites" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
<mxGeometry x="20" y="615" width="420" height="120" as="geometry"/>
</mxCell>
<mxCell id="n_sp5" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Per-tier task delay (emulated)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. edge: + 0 ms (served where the user is)&lt;br&gt;2. core: + 10–12 ms round trip&lt;br&gt;3. cloud: + 50–52 ms round trip" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
<mxGeometry x="20" y="750" width="420" height="100" as="geometry"/>
</mxCell>
</root>
</mxGraphModel></diagram></mxfile>