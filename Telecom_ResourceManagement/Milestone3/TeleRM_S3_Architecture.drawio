<mxCell id="n_cloudnote" value="&lt;b&gt;Hosts&lt;/b&gt; latency-tolerant work under &lt;i&gt;tier_aware&lt;/i&gt;:&lt;br&gt;IMS-CSCF (≤ 50 ms), Transcoder (≤ 50 ms),&lt;br&gt;IoT-GW (≤ 100 ms). Cheapest, biggest, farthest.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not on any critical path&lt;/b&gt;: telemetry lives here&lt;br&gt;because nothing waits for it." style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="n_cloud">
<mxGeometry x="610" y="106" width="420" height="92" as="geometry"/>
