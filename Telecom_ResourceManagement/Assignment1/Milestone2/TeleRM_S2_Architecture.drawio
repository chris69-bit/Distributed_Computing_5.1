<mxCell id="n_g1" value="1. ADMIT&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;10 instances via REQUEST&lt;br&gt;(control plane, port 8000)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#00CC00;fillColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="n_gen">
<mxGeometry x="20" y="45" width="170" height="60" as="geometry"/>
</mxCell>
<mxCell id="n_g2" value="2. SEND TASKS&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Poisson λ = 100…700 /s&lt;br&gt;seeded · share ∝ CPU ÷ work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D6006E;strokeWidth=2;fillColor=#FFF0F6;fontStyle=1;fontSize=11;" vertex="1" parent="n_gen">
<mxGeometry x="210" y="45" width="170" height="60" as="geometry"/>
</mxCell>
<mxCell id="n_g3" value="3. TIME EACH TASK&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;latency = T&lt;sub&gt;resp&lt;/sub&gt; − T&lt;sub&gt;req&lt;/sub&gt;&lt;br&gt;+ 2 × link delay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D6006E;strokeWidth=2;fillColor=#FFF0F6;fontStyle=1;fontSize=11;" vertex="1" parent="n_gen">
<mxGeometry x="400" y="45" width="170" height="60" as="geometry"/>
</mxCell>
<mxCell id="n_g4" value="4. COMPUTE METRICS&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;throughput · latency · jitter&lt;br&gt;loss · CPU · RAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D6006E;strokeWidth=2;fillColor=#FFF0F6;fontStyle=1;fontSize=11;" vertex="1" parent="n_gen">
<mxGeometry x="590" y="45" width="170" height="60" as="geometry"/>
</mxCell>
<mxCell id="n_g5" value="5. ANALYZE&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;analyze.py → charts,&lt;br&gt;bottleneck tables&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D6006E;strokeWidth=2;fillColor=#FFF0F6;fontStyle=1;fontSize=11;" vertex="1" parent="n_gen">
