<mxCell id="n_specT" value="S2 Specifications" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
<mxGeometry x="20" y="830" width="300" height="34" as="geometry"/>
</mxCell>
<mxCell id="n_sp1" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;What S2 adds&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. Traffic TASKs processed by instances&lt;br&gt;2. Per-instance queues + loss&lt;br&gt;3. Persistent data-plane channels&lt;br&gt;4. CPU / RAM measured with psutil" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
<mxGeometry x="20" y="875" width="250" height="120" as="geometry"/>
</mxCell>
<mxCell id="n_sp2" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Metrics&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. Throughput = completed ÷ time&lt;br&gt;2. Latency = T&lt;sub&gt;resp&lt;/sub&gt; − T&lt;sub&gt;req&lt;/sub&gt;&lt;br&gt;3. Jitter = mean |ΔL| per flow&lt;br&gt;4. Loss = (dropped + timeout) ÷ sent&lt;br&gt;5. CPU %, RAM MB per node" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
<mxGeometry x="280" y="875" width="250" height="120" as="geometry"/>
</mxCell>
<mxCell id="n_sp3" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Task work (on a worker)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. vRAN-DU 768 KB&lt;br&gt;2. UPF 512 KB&lt;br&gt;3. IMS-CSCF 256 KB&lt;br&gt;4. Transcoder 2048 KB&lt;br&gt;5. IoT-GW 128 KB (SHA-256 hashing)" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
<mxGeometry x="20" y="990" width="250" height="120" as="geometry"/>
</mxCell>
<mxCell id="n_sp4" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Bottleneck method&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. Latency split: queue / processing / comm / link&lt;br&gt;2. Utilisation law U = X·S ÷ workers&lt;br&gt;3. CPU-cost model predicts the ceiling&lt;br&gt;4. First resource at 100 % = bottleneck" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
<mxGeometry x="280" y="990" width="250" height="120" as="geometry"/>
</mxCell>
